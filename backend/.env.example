PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# Database Configuration (Connects via individual vars OR via DATABASE_URL)
# Option A: Individual Variables (e.g., TiDB Cloud, Aiven, Railway)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=defaultdb
DB_PORT=4000
DB_SSL=true

# Option B: Single connection URI (e.g. Railway MySQL, TiDB, Aiven)
# DATABASE_URL=mysql://user:pass@host:port/dbname?ssl={"rejectUnauthorized":true}

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# AI Services
# Groq Cloud API Key (Free from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google AI Studio Gemini API Key (Free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Verification (Optional - If omitted, users are auto-verified on registration)
# REQUIRE_EMAIL_VERIFICATION=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Doctor Registration Authorization Passcode (Optional, default: DOCTOR2026)
DOCTOR_REGISTRATION_PASSCODE=DOCTOR2026

# Twilio (Optional for SMS / WhatsApp alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
